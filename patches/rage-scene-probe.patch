--- a/gtav/src/native/backend.cpp
+++ b/gtav/src/native/backend.cpp
@@ -278,2 +278,4 @@ REXCVAR_DEFINE_BOOL(gtav_native_write_watch_verify, false, "GTAV",
                     "Native renderer: also hash textures and buffers the write watch says are unchanged, and "
                     "log how many had changed (diagnostic)");
+REXCVAR_DEFINE_BOOL(gtav_native_scene_probe, true, "GTAV",
+                    "Native renderer: draw a depth-tested 3D Plume cube over the presented frame (diagnostic)");
@@ -1987,1 +1987,38 @@
-  // FPS counter (PSDigits) over the bound framebuffer, top-left corner at (x, y).
+  // Depth-tested 3D cube bring-up probe. Uses the existing Plume device and present command list.
+  std::unique_ptr<RenderShader> scene_probe_vs, scene_probe_ps;
+  std::unique_ptr<RenderPipeline> scene_probe_pipeline;
+  RenderFormat scene_probe_format = RenderFormat::UNKNOWN;
+  void DrawSceneProbe(RenderCommandList* list, RenderFormat format) {
+    if (!REXCVAR_GET(gtav_native_scene_probe)) return;
+    InvalidateDrawState();
+    if (!scene_probe_vs)
+      scene_probe_vs = device->createShader(g_native_scene_probe_vs, sizeof(g_native_scene_probe_vs),
+                                            "VSSceneProbe", RenderShaderFormat::SPIRV);
+    if (!scene_probe_ps)
+      scene_probe_ps = device->createShader(g_native_scene_probe_ps, sizeof(g_native_scene_probe_ps),
+                                            "PSSceneProbe", RenderShaderFormat::SPIRV);
+    if (!scene_probe_vs || !scene_probe_ps) return;
+    if (!scene_probe_pipeline || scene_probe_format != format) {
+      RenderGraphicsPipelineDesc desc;
+      desc.pipelineLayout = layout.get();
+      desc.vertexShader = scene_probe_vs.get();
+      desc.pixelShader = scene_probe_ps.get();
+      desc.renderTargetCount = 1;
+      desc.renderTargetFormat[0] = format;
+      desc.renderTargetBlend[0] = RenderBlendDesc::Copy();
+      desc.depthEnabled = true;
+      desc.depthWriteEnabled = true;
+      desc.depthFunction = RenderComparisonFunction::LESS;
+      desc.depthTargetFormat = RenderFormat::D32_FLOAT;
+      scene_probe_pipeline = device->createGraphicsPipeline(desc);
+      scene_probe_format = format;
+    }
+    if (!scene_probe_pipeline) return;
+    list->setGraphicsPipelineLayout(layout.get());
+    list->setPipeline(scene_probe_pipeline.get());
+    list->drawInstanced(36, 1, 0, 0);
+  }
+
+  // FPS counter (PSDigits) over the bound framebuffer, top-left corner at (x, y).
@@ -6107,4 +6107,8 @@ void Backend::Blit(RenderCommandList* list, uint32_t descriptor, RenderFormat target_format) {
   impl_->BlitTo(list, descriptor, target_format);
 }
 
+void Backend::DrawSceneProbe(RenderCommandList* list, RenderFormat target_format) {
+  impl_->DrawSceneProbe(list, target_format);
+}
