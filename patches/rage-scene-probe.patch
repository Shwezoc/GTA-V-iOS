diff --git a/gtav/src/native/shaders/native_scene_probe.hlsl b/gtav/src/native/shaders/native_scene_probe.hlsl
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/gtav/src/native/shaders/native_scene_probe.hlsl
@@ -0,0 +1,61 @@
+struct SceneProbeVertex {
+    float4 position : SV_Position;
+    float3 color : COLOR0;
+};
+
+SceneProbeVertex VSSceneProbe(uint vertex_id : SV_VertexID) {
+    const float3 vertices[36] = {
+        float3(-1,-1,-1), float3(-1, 1,-1), float3( 1, 1,-1),
+        float3(-1,-1,-1), float3( 1, 1,-1), float3( 1,-1,-1),
+        float3(-1,-1, 1), float3( 1, 1, 1), float3(-1, 1, 1),
+        float3(-1,-1, 1), float3( 1,-1, 1), float3( 1, 1, 1),
+        float3(-1,-1,-1), float3(-1,-1, 1), float3(-1, 1, 1),
+        float3(-1,-1,-1), float3(-1, 1, 1), float3(-1, 1,-1),
+        float3( 1,-1,-1), float3( 1, 1, 1), float3( 1,-1, 1),
+        float3( 1,-1,-1), float3( 1, 1,-1), float3( 1, 1, 1),
+        float3(-1,-1,-1), float3( 1,-1, 1), float3(-1,-1, 1),
+        float3(-1,-1,-1), float3( 1,-1,-1), float3( 1,-1, 1),
+        float3(-1, 1,-1), float3(-1, 1, 1), float3( 1, 1, 1),
+        float3(-1, 1,-1), float3( 1, 1, 1), float3( 1, 1,-1)
+    };
+    const float3 face_colors[6] = {
+        float3(0.95, 0.20, 0.16), float3(0.15, 0.75, 0.30),
+        float3(0.15, 0.45, 0.95), float3(0.95, 0.75, 0.12),
+        float3(0.75, 0.20, 0.90), float3(0.10, 0.85, 0.85)
+    };
+    float3 p = vertices[vertex_id];
+    float cy = cos(0.62), sy = sin(0.62);
+    float cx = cos(-0.38), sx = sin(-0.38);
+    float3 rotated;
+    rotated.x = p.x * cy - p.z * sy;
+    rotated.z = p.x * sy + p.z * cy;
+    rotated.y = p.y;
+    float y = rotated.y * cx - rotated.z * sx;
+    float z = rotated.y * sx + rotated.z * cx + 3.5;
+    SceneProbeVertex output;
+    output.position = float4(rotated.x * 1.25, y * 1.25, z * 0.18, z);
+    output.color = face_colors[vertex_id / 6];
+    return output;
+}
+
+float4 PSSceneProbe(SceneProbeVertex input) : SV_Target0 {
+    return float4(input.color, 1.0);
+}
