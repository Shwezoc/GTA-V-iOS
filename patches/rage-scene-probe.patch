diff --git a/gtav/src/native/shaders/native_scene_probe.hlsl b/gtav/src/native/shaders/native_scene_probe.hlsl
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/gtav/src/native/shaders/native_scene_probe.hlsl
@@ -0,0 +1,26 @@
+struct SceneProbeVertex {
+    float4 position : SV_Position;
+};
+
+SceneProbeVertex VSSceneProbe(uint vertex_id : SV_VertexID) {
+    const float2 positions[3] = {
+        float2(-0.55, -0.45),
+        float2( 0.55, -0.45),
+        float2( 0.00,  0.55)
+    };
+    SceneProbeVertex output;
+    output.position = float4(positions[vertex_id], 0.35, 1.0);
+    return output;
+}
+
+float4 PSSceneProbe() : SV_Target0 {
+    return float4(0.05, 0.85, 0.95, 1.0);
+}
